# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials.

# Postgres connection string (Supabase, Neon, Vercel Postgres, Railway, etc).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public"

# Google Places API key — used for address/company lookup and autocomplete.
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_PLACES_API_KEY=""

# Public contact email shown in the site footer.
NEXT_PUBLIC_CONTACT_EMAIL="info@bidcore.in"

# SMTP — used to send notification emails when someone submits a form
# (list a company, sign in / create profile, qualification).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="Bidcore"
TO_EMAIL=""

# Signs the login session cookie (generate with: openssl rand -hex 32).
SESSION_SECRET=""

# ── BidcoreAI connection (www.bidcore.in is the public front door of Bidcore Tender Connect) ──────────────────────
# Base URL of the BidcoreAI backend API (public tenders, subscribed companies, member sync).
BIDCORE_API_URL=
NEXT_PUBLIC_BIDCORE_API_URL=
# The BidcoreAI web app: every product's Sign In / Sign Up / Prepare Quotation continues here.
NEXT_PUBLIC_APP_URL=https://app.bidcoreai.com
# This site's own address (canonical links, sitemap).
SITE_URL=https://www.bidcore.in
# Must equal PUBLIC_SITE_KEY on the backend: lets this server read the public API at a higher rate limit.
PUBLIC_SITE_KEY=
# Must equal WEBSITE_SYNC_SECRET on the backend: signs the member -> BidcoreAI India database copy.
WEBSITE_SYNC_SECRET=
# Protects POST /api/contractor-sync/retry (called by a scheduler).
SYNC_RETRY_KEY=

# Phone OTP by SMS (MSG91) for Indian (+91) numbers on the add-your-details / view-contacts sign-ups. Needs a DLT-approved OTP template containing ##OTP##.
# Leave unset in development (the code is printed in the server console instead); production refuses to send without them.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# The BidcoreAI (US) website; the IN / US country switch sends visitors there when they choose US.
NEXT_PUBLIC_US_SITE_URL=https://www.bidcoreai.com
